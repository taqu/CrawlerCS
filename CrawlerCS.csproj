<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="tika-config.xml" />
    <None Remove="tika-server.jar" />
    <None Remove="tika\tika-config.xml" />
    <None Remove="tika\tika-server.jar" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="tika\tika-config.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tika\tika-server.jar">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="System.IO.Hashing" Version="9.0.5" />
  </ItemGroup>

</Project>
